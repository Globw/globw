{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Globw",
  "scopeName": "source.globw",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.quote.globw",
      "match": "'.*$"
    },
    "string": {
      "name": "string.quoted.double.globw",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.globw",
          "match": "\\\\[n\"\\\\]"
        }
      ]
    },
    "definition": {
      "match": "\\b(function|procedure)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.globw"
        },
        "2": {
          "name": "entity.name.function.globw"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "name": "variable.language.self.globw",
          "match": "\\bparent\\b"
        },
        {
          "name": "variable.language.self.globw",
          "match": "\\bself\\b"
        },
        {
          "name": "keyword.control.globw",
          "match": "\\b(lazy|import|break|continue|in|if|else|end\\s+if|while|end\\s+loop|for|from|to|step|repeat|return|end\\s+function|end\\s+procedure|end\\s+class|class|new|is)\\b"
        },
        {
          "name": "storage.type.function.globw",
          "match": "\\b(function|procedure)\\b"
        },
        {
          "name": "storage.modifier.globw",
          "match": "\\bglobal\\b"
        },
        {
          "name": "keyword.other.declaration.globw",
          "match": "\\bvariables\\s*:"
        },
        {
          "name": "keyword.operator.word.globw",
          "match": "\\b(and|or|not|div|mod)\\b"
        },
        {
          "name": "constant.language.boolean.globw",
          "match": "\\b(true|false)\\b"
        },
        {
          "name": "support.function.builtin.globw",
          "match": "\\b(remove_key|has_key|values|keys|get|random_float|exponential|append_file|file_exists|starts_with|clear_list|triangle3d|read_lines|text_width|write_file|lowercase|uppercase|read_file|ends_with|take_last|substring|logarithm|to_binary|absolute|to_float|index_of|round_to|contains|truncate|to_text|arctan2|mouse_y|ceiling|replace|confirm|maximum|minimum|mouse_x|reverse|message|sphere|rotate|to_int|camera|append|arccos|remove|random|arctan|to_hex|circle|arcsin|insert|window|output|length|floor|count|round|split|input|power|click|clear|today|sqrt|rect|line|wait|stop|join|sort|show|trim|font|cube|time|open|text|char|find|code|cos|now|box|sin|sum|rgb|key|ask|tan|pi)(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "keyword.other.as.globw",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.globw",
          "match": "\\b(list|dict)\\s+of\\b"
        },
        {
          "name": "storage.type.primitive.globw",
          "match": "\\b(int|float|string|bool)\\b"
        }
      ]
    },
    "calls": {
      "name": "entity.name.function.globw",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    "numbers": {
      "name": "constant.numeric.globw",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.globw",
          "match": "=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.globw",
          "match": "<=|>=|!=|==|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.globw",
          "match": "[+*/-]"
        }
      ]
    },
    "variables": {
      "name": "variable.other.globw",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*"
    }
  }
}
