pographicpoint|actus_roman|gravitypluto|pottle|litreperhour|cubicfootperminute|hogshead|milligauss|gamma_mag|radian|watthour|squarelink|toise|mebibyte|jupitermass|obol|horsepower_mech|centistokes|poundpercubicfoot|horsepower_electric|footperminute|milliwatt|fermi|eulernumber|pood|watch_time|quart_us|kilohertz|magnum|gelfond|braccio|roentgen|squaremile|sazhen|cun_chinese|omer|horsepowerhour|enzymeunit|vonklitzing|squarechain|barreloilperday|backhouse|hour|gauss_const|decametre|crinal|zhang|poundmole|planckmass|gramforcecentimetre|day|bit|octet|nail|poundforcefoot|millsconstant|circularmil|millilitre|league|dessertspoon|kilocalorie|firkin|log10e|cubicmetre|wallis_const|millimole|qword|pennyweight|decalitre|decagram|lightsecond|megaelectronvolt|ln10|eulergamma|squareyard|arcsecond|cubicyard|bushel_us|quad|ke_time|tablespoon_us|decimetre|footpoundal|catty|go_japanese|tael|gallon_imp|phi|puncheon|week|absolutezero_c|point_compass|ken_japanese|nuclearmagneton|sqrt5|gravityneptune|squareperch|nanosecond|lunardistance|molarvolume|millinewton|bpm_freq|soundspeedair|cyclepersecond|butt_vol|foot|cubit|milphot|ln2|atomicmassunit|gramperlitre|goldenangle|tonne|wineglass_cook|rood_area|year_common|bohrmagneton|viswanath|didotpoint|poundpergallon_imp|terabyte|milliamperehour|banana_dose|caliber|mph|centipoise|lemniscate|poncelet|micromole|lambda_vol|atmosphere|erdosborwein|section_area|deviccoconst|lusec|golombdickman|bohrradius|sierpinski_const|footpound|sqrt2|verst|kilolitre|gravitysun|kipforce|pound|momme|smoot|footpoundpersecond|kilonewton|longton|milesperlitre|kilonewtonmetre|cbrt2|chain|standardgravity_const|btuperhour|koku|inch|litreatmosphere|feigenbaumdelta|month_avg|pieze|gravityvenus|microcurie|caloriepersecond|planck_time|millisecond|ounce|milligram|kmh|conwayconstant|tau_const|milespergallon_imp|microgram|bale|terahertz|apery|curie|to_japanese|kilobyte|log2e|poundpercubicinch|megabyte|ri_japanese|morgen|rydberg_energy|picul|electronmass_const|omegaconstant|pebibyte|ounceforce|gravityceres|pinch_cook|gigapascal|kmperhourpersecond|nebuchadnezzar|troyounce|millibar|kilogramforcemetre|keel|mite_mass|township|kilowatthour|universalparabolic|millennium|ghurry|gradian|rutherford|mile|kilopascal|gravitymercury|gram|uncia_roman|octant_angle|fluidounce_us|pint_us|astronomicalunit|tonneforce|hectopascal|kilogrampercubicmetre|reducedplanck|cubiccentimetre|cuerda|oka_volume|hand|megametre|milepersecond|niven|dyne|gallon_us|megawatthour|congius|inwater|foiasconst|lustrum|solarradius|minute|rotl|weber_mag|gravitymoon|solarconstant|petabyte|faradayconstant_c|nanometre|stokes|point_adobe|cable|squarecentimetre|kilobecquerel|myriametre|litresper100km_inv|yard|hectometre|terametre|milliradian|earthgravity|carat|metreperminute|squaremetre|maxwell_mag|ergpersecond|electronvolt_const|xunit|cyathus|clove|gravitytitan|khinchin|parsec|earthmass|pony|gibibyte|josephsonconst|barrel_us|cubicmetreperhour|span|kilotonne|somosquad|talent|millijoule|lightyear|inchpersecond|gravitymars|squarenauticalmile|quartern|britishthermalunit|abcoulomb|mebibit|solarmass|centiare|dram|tontnt|millitesla|nanomole|cord|rope|kilotontnt|shot_vol|psi|kilolux|ramanujansoldner|gill_us|silverratio|sextarius|crumb)\\.([\\p{L}_][\\p{L}\\p{N}_]*)(?=\\s*\\()",
          "captures": {
            "1": {
              "name": "support.class.module.globw"
            },
            "2": {
              "name": "support.function.builtin.globw"
            }
          }
        },
        {
          "name": "variable.language.self.globw",
          "match": "\\bparent\\b"
        },
        {
          "name": "variable.language.self.globw",
          "match": "\\bself\\b"
        },
        {
          "name": "keyword.control.globw",
          "match": "\\b(lazy|import|break|continue|in|if|else|end\\s+if|while|end\\s+loop|for|from|to|step|repeat|return|end\\s+function|end\\s+procedure|end\\s+class|end\\s+try|class|new|is|try|catch|always|fail|gives)\\b"
        },
        {
          "name": "storage.type.function.globw",
          "match": "\\b(function|procedure)\\b"
        },
        {
          "name": "storage.modifier.globw",
          "match": "\\bglobal\\b"
        },
        {
          "name": "keyword.other.declaration.globw",
          "match": "\\bvariables\\s*:"
        },
        {
          "name": "keyword.operator.word.globw",
          "match": "\\b(and|or|not|div|mod)\\b"
        },
        {
          "name": "constant.language.boolean.globw",
          "match": "\\b(true|false|none)\\b"
        },
        {
          "name": "support.function.builtin.globw",
          "match": "\\b(add|discard|to_list|transform|keep|reduce|remove_key|has_key|values|keys|get|random_float|exponential|append_file|file_exists|starts_with|clear_list|triangle3d|read_lines|text_width|write_file|lowercase|uppercase|read_file|ends_with|take_last|substring|logarithm|to_binary|absolute|to_float|index_of|round_to|contains|truncate|to_text|arctan2|mouse_y|ceiling|replace|confirm|maximum|minimum|mouse_x|reverse|message|sphere|rotate|to_int|camera|append|arccos|remove|random|arctan|to_hex|circle|arcsin|insert|window|output|length|floor|count|round|split|input|power|click|clear|today|sqrt|rect|line|wait|stop|join|sort|show|trim|font|cube|time|open|text|char|find|code|cos|now|box|sin|sum|rgb|key|ask|tan|pi)(?=\\s*\\()"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "keyword.other.as.globw",
          "match": "\\bas\\b"
        },
        {
          "name": "storage.type.globw",
          "match": "\\b(list|dict|set|tuple|nungw)\\s+of\\b"
        },
        {
          "name": "storage.type.primitive.globw",
          "match": "\\b(int|float|string|bool)\\b"
        }
      ]
    },
    "calls": {
      "name": "entity.name.function.globw",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*(?=\\s*\\()"
    },
    "numbers": {
      "name": "constant.numeric.globw",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.globw",
          "match": "=(?!=)"
        },
        {
          "name": "keyword.operator.comparison.globw",
          "match": "<=|>=|!=|==|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.globw",
          "match": "[+*/-]"
        }
      ]
    },
    "variables": {
      "name": "variable.other.globw",
      "match": "(?<![\\p{L}\\p{N}_])[\\p{L}_][\\p{L}\\p{N}_]*"
    }
  }
}
