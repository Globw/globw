{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Globw",
  "scopeName": "source.globw",
  "patterns": [
    {
      "include": "#comment"
    },
    {
      "include": "#string"
    },
    {
      "include": "#definition"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#variables"
    }
  ],
  "repository": {
    "comment": {
      "name": "comment.line.quote.globw",
      "match": "'.*$"
    },
    "string": {
      "name": "string.quoted.double.globw",
      "begin": "\"",
      "end": "\"|$",
      "patterns": [
        {
          "name": "constant.character.escape.globw",
          "match": "\\\\[n\"\\\\]"
        }
      ]
    },
    "definition": {
      "match": "\\b(function|procedure)\\s+([\\p{L}_][\\p{L}\\p{N}_]*)",
      "captures": {
        "1": {
          "name": "storage.type.function.globw"
        },
        "2": {
          "name": "entity.name.function.globw"
        }
      }
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(text|hash|web|data|clock|encode|shell|math|bits|base32|base|roman|temp|angle|percent|geom|length|weight|size|duration|geo|ordinal|fib|prime|str|hex|url|case|slug|ascii|morse|caesar|rot13|rot47|leet|nato|color|valid|luhn|isbn|uuid|crc|env|path|os|dir|file|tmp|args|csv|stats|tax|compass|area|volume|speed|pressure|energy|power|fuel|force|torque|datarate|frequency|cooking|nautical|astro|stone|density|db|tempo|grad|timeof|pace|hyper|ahyper|logs|trigx|choose|seq|modular|lerp|rounding|vec2|vec3|complex|parity|divisible|digits|collatz|perfect|armstrong|palindrome|range|point3|point|slope|root|count|truncate|indent|strip|mask|initials|acronym|pig|atbash|vigenere|bin|html|shout|words|unicode|normalize|anagram|fizzbuzz|quote|rle|wrap|spongebob|clap|bmi|ohm|physics|wave|gravity|interest|loan|tip|discount|roi|money|bearing|triangle|circle|rectangle|sphere|cylinder|cone|weekday|month|leap|age|zodiac|season|grade|logic|yesno|scientific|fraction|heartrate|fnv|djb2|sdbm|adler|ipv4|mac|hexcolor|weburl|dice|coin|pick|token|password|nanoid|otp|lorem|randcolor|factor|totient|compare|clampint|pow|caps|swapcase|consonants|midpoint|isqrt|cycle|digitroot|trapezoid|ellipse|pentagon|hexagon|polygon|pyramid|prism|torus|cuboid|annulus|savings|depreciation|cents|markup|bmr|wind|heat|dewpoint|quadratic|motion|apr|nungw|counter|chart|table|iter|acceleration|lux|radiation|turn|flow|typography|oven|glucose|screen|aspect|beaufort|quake|wrapv|smoothstep|step|sinc|sigmoid|relu|softsign|gauss|erf|gammaf|harmonic|geoseries|arithseries|modulo|hypot3|clampf|frac|reciprocal|precise|rotstr|zfill|nospaces|digitsonly|lettersonly|disemvowel|screaming|dotcase|pathcase|sentencecase|dedup|expandtabs|rot5|hamming|levenshtein|soundex|syllables|avgword|readtime|kinematics|projectile|pendulum|spring|lens|resistors|capacitors|buoyancy|specificgravity|thermo|efficiency|work|moment|impulse|doppler|escape|orbit|redshift|lorentz|halflife|decay|growth|rule72|annuity|breakeven|profit|commission|wage|i