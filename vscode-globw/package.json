{
  "name": "globw",
  "displayName": "Globw",
  "description": "Syntax, run, debugger, live errors, completion, hover, formatting, outline and go-to-definition for Globw (.gw)",
  "version": "1.48.0",
  "license": "Apache-2.0",
  "icon": "images/logo-square.png",
  "publisher": "globw",
  "repository": {
    "type": "git",
    "url": "https://github.com/Globw/globw.git"
  },
  "homepage": "https://github.com/Globw/globw#readme",
  "bugs": {
    "url": "https://github.com/Globw/globw/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers",
    "Formatters",
    "Snippets"
  ],
  "keywords": [
    "globw",
    "gw",
    "language",
    "interpreter",
    "formatter"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:globw",
    "onDebugResolve:globw",
    "onDebugDynamicConfigurations:globw"
  ],
  "contributes": {
    "languages": [
      {
        "id": "globw",
        "aliases": [
          "Globw",
          "globw"
        ],
        "extensions": [
          ".gw"
        ],
        "icon": {
          "light": "./images/gw-light.svg",
          "dark": "./images/gw-dark.svg"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "globw",
        "scopeName": "source.globw",
        "path": "./syntaxes/globw.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "globw.run",
        "title": "Run Globw program",
        "category": "Globw",
        "icon": "$(play)"
      },
      {
        "command": "globw.debug",
        "title": "Debug Globw program",
        "category": "Globw",
        "icon": "$(debug-alt)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "globw.run",
          "when": "editorLangId == globw",
          "group": "navigation"
        },
        {
          "command": "globw.debug",
          "when": "editorLangId == globw",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "globw.run",
        "key": "f5",
        "when": "editorLangId == globw && !inDebugMode"
      }
    ],
    "configuration": {
      "title": "Globw",
      "properties": {
        "globw.path": {
          "type": "string",
          "default": "",
          "description": "Path to the gw executable. Empty: use target/release/gw in the workspace, or `gw` from PATH."
        }
      }
    },
    "breakpoints": [
      {
        "language": "globw"
      }
    ],
    "debuggers": [
      {
        "type": "globw",
        "label": "Globw",
        "languages": [
          "globw"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .gw file to debug.",
                "default": "${file}"
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop at the first line of the program.",
                "default": false
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Permissions, as on the command line: --allow-read, --allow-write, --allow-net, --allow-run, --allow-all.",
                "default": []
              },
              "input": {
                "type": "string",
                "description": "The text that input() reads while debugging, one line per answer (write \\n between lines).",
                "default": ""
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "globw",
            "request": "launch",
            "name": "Debug Globw program",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Globw: Debug the current file",
            "description": "Debug the .gw file open in the editor",
            "body": {
              "type": "globw",
              "request": "launch",
              "name": "Debug Globw program",
              "program": "^\"\\${file}\""
            }
          }
        ]
      }
    ]
  },
  "scripts": {
    "test": "node --test test/parse.test.js test/grammar.test.js"
  }
}
