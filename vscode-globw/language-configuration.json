{
  "comments": {
    "lineComment": "'"
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(((if|else|while|for|repeat|function|procedure)\\b(?!.*\\bend\\b).*)|((global\\s+)?variables\\s*:\\s*))$",
    "decreaseIndentPattern": "^\\s*(end\\s+(if|loop|function|procedure)|else)\\b"
  },
  "wordPattern": "[\\p{L}_][\\p{L}\\p{N}_]*"
}
