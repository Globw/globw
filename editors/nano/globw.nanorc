## Globw syntax highlighting for nano (https://globw.org)
## Installed by the .deb and .rpm packages as /usr/share/nano/globw.nanorc.
## By hand: copy it there, or add  include "/path/to/globw.nanorc"  to ~/.nanorc

syntax globw "\.gw$"
comment "'"

## calls: a name followed by (
color brightcyan "\<[A-Za-z_][A-Za-z0-9_]*[[:space:]]*\("

## numbers
color brightmagenta "\<[0-9]+(\.[0-9]+)?\>"

## types and declarations
color green "\<(int|float|string|bool|as)\>"
color green "\<(list|dict|set|tuple|nungw)[[:space:]]+of\>"

## keywords (including the two-word ends)
color brightred "\<(lazy|import|break|continue|in|if|else|while|for|from|to|step|repeat|return|class|new|is|try|catch|always|fail|gives|const|match|when|enum|function|procedure|global)\>"
color brightred "\<end[[:space:]]+(if|loop|function|procedure|class|try|match|enum)\>"
color brightred "\<variables[[:space:]]*:"

## operators written as words, constants
color yellow "\<(and|or|not|div|mod)\>"
color brightmagenta "\<(true|false|none|self|parent)\>"

## strings (to the closing quote or the end of the line)
color brightyellow ""([^"\\]|\\.)*("|$)"

## comments: from ' to the end of the line, when no string follows
color brightblue "'[^"]*$"
