variables:
    grades as int[5]
    i, total as int
    average as float
for(i from 1 to 5)
    input(grades[i])
end loop
total = 0
for(i from 1 to 5)
    total = total + grades[i]
end loop
average = total / 5
output("Average: ", average)
if(average >= 8)
    output("Great")
else if(average >= 6)
    output("Pass")
else
    output("Fail")
end if
