' ==================================================
'  PONG per due giocatori
'  Sinistra: W / S        Destra: freccia SU / GIÙ
'  Vince chi arriva per primo a 5 punti.
' ==================================================

global variables:
    bx, by, vx, vy as float
    y1, y2 as float
    punti1, punti2 as int

variables:
    vincitore as string
    ancora as bool


' rimette la pallina al centro e la lancia verso destra (1) o sinistra (-1)
procedure servi(verso as float)
    bx = 400
    by = 300
    vx = 5 * verso
    vy = random(-3, 3)
end procedure

procedure muoviRacchette()
    if(key("W") and y1 > 0)
        y1 = y1 - 7
    end if
    if(key("S") and y1 < 500)
        y1 = y1 + 7
    end if
    if(key("UP") and y2 > 0)
        y2 = y2 - 7
    end if
    if(key("DOWN") and y2 < 500)
        y2 = y2 + 7
    end if
end procedure

' la pallina accelera un po' a ogni colpo, fino a un massimo
procedure colpo(centroRacchetta as float)
    vx = -vx * 1.07
    if(vx > 14)
        vx = 14
    else if(vx < -14)
        vx = -14
    end if
    ' più lontano dal centro della racchetta, più la pallina devia
    vy = (by - centroRacchetta) / 8
end procedure

procedure muoviPallina()
    bx = bx + vx
    by = by + vy
    if(by < 10)
        by = 10
        vy = -vy
    else if(by > 590)
        by = 590
        vy = -vy
    end if
    if(vx < 0 and bx - 10 <= 45 and bx >= 30 and by >= y1 and by <= y1 + 100)
        colpo(y1 + 50)
    end if
    if(vx > 0 and bx + 10 >= 755 and bx <= 770 and by >= y2 and by <= y2 + 100)
        colpo(y2 + 50)
    end if
    if(bx < -20)
        punti2 = punti2 + 1
        servi(1)
    else if(bx > 820)
        punti1 = punti1 + 1
        servi(-1)
    end if
end procedure

procedure disegna()
    variables:
        y as int
    clear("black")
    for(y from 0 to 600 step 40)
        rect(398, y, 4, 20, "gray")
    end loop
    rect(30, y1, 15, 100, "white")
    rect(755, y2, 15, 100, "white")
    circle(bx, by, 10, "yellow")
    text(340, 20, "" + punti1, "white")
    text(444, 20, "" + punti2, "white")
    text(10, 575, "W/S", "gray")
    text(700, 575, "SU/GIU", "gray")
end procedure


window(800, 600, "Pong")
ancora = true
while(ancora and open())
    punti1 = 0
    punti2 = 0
    y1 = 250
    y2 = 250
    servi(1)
    while(open() and punti1 < 5 and punti2 < 5)
        muoviRacchette()
        muoviPallina()
        disegna()
        show()
    end loop
    if(open())
        if(punti1 == 5)
            vincitore = "Il giocatore SINISTRO"
        else
            vincitore = "Il giocatore DESTRO"
        end if
        disegna()
        text(160, 280, vincitore + " ha vinto!", "yellow")
        show()
        ancora = confirm(vincitore + " ha vinto " + punti1 + " a " + punti2 + "! Giocare ancora?")
    end if
end loop
