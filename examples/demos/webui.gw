' A web interface for a Globw program. The look lives in webui/ (HTML, CSS, JS);
' the logic lives here: Globw serves those files and answers a small JSON API.
' Run it with:
'     gw --allow-net --allow-read --allow-run examples/demos/webui.gw
import serve
import ui
import data

variables:
    s as int
    req as string
    route as string
    sides as int
    rolls as int
    roll as dict of string to int

rolls = 0
s = serve.start(8099)
output("Serving on http://localhost:8099/  -  press Ctrl-C to stop")
ui.app("http://localhost:8099/")              ' open it as an app window

while(true)
    req = serve.wait(s)
    route = data.text(req, "route")           ' the path without ?query
    if(route == "/api/roll")
        sides = 6
        if(data.has(req, "query.sides"))
            sides = to_int(data.text(req, "query.sides"))
        end if
        rolls = rolls + 1
        roll["sides"] = sides
        roll["value"] = random(1, sides)
        roll["rolls"] = rolls
        serve.reply_as(s, 200, "application/json", data.to_json(roll))
    else
        serve.file(s, "webui", route)         ' index.html, style.css, app.js
    end if
end loop
