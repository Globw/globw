' nn: a small neural-network library in Globw, built on the nungw array engine.
' A sequential MLP of any depth: ReLU on the hidden layers, sigmoid on the
' output, mean-squared-error loss, trained with the Adam optimizer.
' A network is a value -- the list [W1, b1, W2, b2, ...] -- so you can keep many.
import nungw

function relu(z as nungw of float) as nungw of float
    return nungw.scale(nungw.add(z, nungw.abs(z)), 0.5)        ' (z + |z|)/2 = max(z, 0)
end function
function sigmoid(z as nungw of float) as nungw of float
    return nungw.recip(nungw.offset(nungw.exp(nungw.neg(z)), 1.0))
end function

' Build a network. sizes is e.g. [2, 8, 8, 1] (inputs, hidden..., outputs).
function mlp(sizes as list of int) as list of nungw of float
    variables:
        net as list of nungw of float
        l, ni, no as int
    for(l from 1 to length(sizes) - 1)
        ni = sizes[l]
        no = sizes[l + 1]
        append(net, nungw.reshape(nungw.scale(nungw.randn(ni * no), 0.5), [ni, no]))
        append(net, nungw.zeros(no))
    end loop
    return net
end function

' Forward pass over a batch x (rows x inputs). Returns the output (rows x outputs).
function predict(net as list of nungw of float, x as nungw of float, rows as int) as nungw of float
    variables:
        a, w, b, z as nungw of float
        l, layers, ni, no as int
        shp as list of int
    layers = length(net) div 2
    a = x
    for(l from 1 to layers)
        w = net[2 * l - 1]
        b = net[2 * l]
        shp = nungw.shape(w)
        ni = shp[1]
        no = shp[2]
        z = nungw.matmul(a, rows, ni, w, no) + b
        if(l < layers)
            a = relu(z)
        else
            a = sigmoid(z)
        end if
    end loop
    return a
end function

function loss(net as list of nungw of float, x as nungw of float, y as nungw of float, rows as int) as float
    return nungw.mean(nungw.square(nungw.sub(predict(net, x, rows), y)))
end function

' Train in place with Adam (full-batch backpropagation).
procedure train(net as list of nungw of float, x as nungw of float, y as nungw of float, rows as int, epochs as int, lr as float)
    variables:
        acts, grads, mm, vv as list of nungw of float
        w, b, a, z, dcur, ad, dz, g, mhat, vhat as nungw of float
        shp as list of int
        epoch, l, layers, i, np, ni, no as int
        beta1, beta2, eps, bp1, bp2, bc1, bc2 as float
    layers = length(net) div 2
    np = length(net)
    beta1 = 0.9
    beta2 = 0.999
    eps = 0.00000001
    bp1 = 1.0
    bp2 = 1.0
    for(i from 1 to np)
        append(mm, nungw.scale(net[i], 0.0))
        append(vv, nungw.scale(net[i], 0.0))
        append(grads, net[i])
    end loop
    for(i from 1 to layers + 1)
        append(acts, x)
    end loop
    for(epoch from 1 to epochs)
        ' forward, storing activations
        acts[1] = x
        a = x
        for(l from 1 to layers)
            w = net[2 * l - 1]
            b = net[2 * l]
            shp = nungw.shape(w)
            ni = shp[1]
            no = shp[2]
            z = nungw.matmul(a, rows, ni, w, no) + b
            if(l < layers)
                a = relu(z)
            else
                a = sigmoid(z)
            end if
            acts[l + 1] = a
        end loop
        ' backward
        dcur = nungw.sub(acts[layers + 1], y)
        for(l from layers to 1 step -1)
            shp = nungw.shape(net[2 * l - 1])
            ni = shp[1]
            no = shp[2]
            if(l == layers)
                ad = nungw.mul(acts[l + 1], nungw.scalar_sub(acts[l + 1], 1.0))
            else
                ad = nungw.sign(acts[l + 1])
            end if
            dz = nungw.mul(dcur, ad)
            grads[2 * l - 1] = nungw.matmul(nungw.transpose(acts[l], rows, ni), ni, rows, dz, no)
            grads[2 * l] = nungw.sum_axis(dz, 0)
            if(l > 1)
                dcur = nungw.matmul(dz, rows, no, nungw.transpose(net[2 * l - 1], ni, no), ni)
            end if
        end loop
        ' Adam update
        bp1 = bp1 * beta1
        bp2 = bp2 * beta2
        bc1 = 1.0 - bp1
        bc2 = 1.0 - bp2
        for(i from 1 to np)
            mm[i] = nungw.add(nungw.scale(mm[i], beta1), nungw.scale(grads[i], 1.0 - beta1))
            vv[i] = nungw.add(nungw.scale(vv[i], beta2), nungw.scale(nungw.square(grads[i]), 1.0 - beta2))
            mhat = nungw.scale(mm[i], 1.0 / bc1)
            vhat = nungw.scale(vv[i], 1.0 / bc2)
            g = nungw.div(mhat, nungw.offset(nungw.sqrt(vhat), eps))
            net[i] = nungw.sub(net[i], nungw.scale(g, lr))
        end loop
    end loop
end procedure
