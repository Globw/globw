' The grid engine: a first-class "grid of float" worked on in parallel.
import grid
variables:
    a, b, c as grid of float
a = grid.of([1.0, 2.0, 3.0, 4.0])
b = grid.of([10.0, 20.0, 30.0, 40.0])
c = a * 2.0 + b                      ' operators work element-wise
output(grid.to_list(c))
output(a[1], " ", a[4])              ' indexing is 1-based
output(grid.sum(a), " ", grid.dot(a, b), " ", grid.norm(a))
c = grid.sqrt(a) * 10.0
output(grid.to_list(c))
