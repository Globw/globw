' nungw: clip, scans, sort/argsort, identity, concatenate, select. vs NumPy.
' (rand/randn exist too but are random, so they are not in this fixed-output test.)
import nungw
variables:
    a, b, c as nungw of float
a = nungw.of([3.0, 1.0, 4.0, 1.5, 5.0, 9.0])
output(nungw.to_list(nungw.clip(a, 2.0, 5.0)))
output(nungw.to_list(nungw.cumsum(a)))
output(nungw.to_list(nungw.cumprod(nungw.of([1.0, 2.0, 3.0, 4.0]))))
output(nungw.to_list(nungw.sort(a)))
output(nungw.to_list(nungw.argsort(a)))           ' positions, 1-based
output(nungw.to_list(nungw.eye(3)))
output(nungw.shape(nungw.eye(3)))
b = nungw.of([7.0, 8.0])
output(nungw.to_list(nungw.concat(a, b)))
c = nungw.of([1.0, 0.0, 1.0, 0.0, 1.0, 0.0])
output(nungw.to_list(nungw.where(c, a, nungw.neg(a))))
