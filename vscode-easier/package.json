{
  "name": "easier",
  "displayName": "Easier",
  "description": "Syntax colors, run button and live errors for the Easier pseudocode language (.ez)",
  "version": "0.2.0",
  "publisher": "local",
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": ["onLanguage:easier"],
  "contributes": {
    "languages": [
      {
        "id": "easier",
        "aliases": ["Easier", "easier"],
        "extensions": [".ez"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "easier",
        "scopeName": "source.easier",
        "path": "./syntaxes/easier.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "easier.run",
        "title": "Run Easier program",
        "category": "Easier",
        "icon": "$(play)"
      }
    ],
    "menus": {
      "editor/title": [
        { "command": "easier.run", "when": "editorLangId == easier", "group": "navigation" }
      ]
    },
    "keybindings": [
      { "command": "easier.run", "key": "f5", "when": "editorLangId == easier" },
      {
        "command": "type",
        "args": { "text": "<- " },
        "key": "ctrl+[Slash] ctrl+[IntlBackslash]",
        "when": "editorTextFocus && editorLangId == easier"
      }
    ],
    "configuration": {
      "title": "Easier",
      "properties": {
        "easier.path": {
          "type": "string",
          "default": "",
          "description": "Path to easier.exe. Empty: use the build in C:\\Users\\Utente\\easier, or `easier` from PATH."
        }
      }
    }
  },
  "scripts": { "test": "node --test test/parse.test.js test/grammar.test.js" }
}
